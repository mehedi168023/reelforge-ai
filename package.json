{
  "name": "reelforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vite build --mode mock --outDir dist-test && node tools/e2e.mjs",
    "desktop:dev": "node tools/desktop-dev.mjs",
    "desktop": "vite build && electron .",
    "dist:win": "tsc --noEmit && vite build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "mediabunny": "^1.65.2",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "ReelForge",
  "description": "ReelForge: AI video editor for reels, promos and explainers",
  "author": "ReelForge",
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.reelforge.desktop",
    "productName": "ReelForge",
    "copyright": "ReelForge",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**",
      "electron/*.cjs",
      "electron/icon.png",
      "package.json",
      "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "electron/mcp-bridge.cjs",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "ReelForge"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
